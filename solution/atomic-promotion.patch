+    def _promote_schedule(self, ts, prepare):
+        """Move due rows with their prepared payloads in one transaction.
+
+        ``prepare`` performs the caller's decoding and encoding before any
+        durable mutation. The returned objects are used only after commit;
+        notifications must never run while the storage lock is held.
+        """
+        with self.db(commit=True) as curs:
+            curs.execute('select id, data from schedule where '
+                         'queue = ? and timestamp <= ? order by timestamp, id',
+                         (self.name, ts.timestamp()))
+            rows = curs.fetchall()
+            prepared = [prepare(data) for _, data in rows]
+            curs.executemany(
+                'insert into task (queue, data, priority) values (?, ?, ?)',
+                [(self.name, self.to_blob(data), priority or 0)
+                 for _, data, priority in prepared])
+            curs.executemany('delete from schedule where queue = ? and id = ?',
+                             [(self.name, row_id) for row_id, _ in rows])
+        return [task for task, _, _ in prepared]
