+    def promote_schedule(self, timestamp=None):
+        """Enqueue due scheduled tasks and return the number promoted.
+
+        SQLite transfers the entire batch atomically, including preparation
+        of each serialized task. Other backends retain their existing
+        destructive-read/enqueue behavior.
